{
  "name": "simultaneous-interpreter",
  "version": "2.0.0",
  "description": "Real-time simultaneous interpretation for Chinese-English with local AI models",
  "author": "Simultaneous Interpreter Team <simultaneous@interpreter.app>",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --ext .ts,.tsx",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@xenova/transformers": "^2.17.2",
    "electron-store": "^8.2.0",
    "sherpa-onnx-node": "^1.13.2",
    "tar-stream": "^3.1.7",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-darwin-arm64": "^1.13.2",
    "sherpa-onnx-linux-x64": "^1.13.2",
    "sherpa-onnx-win-x64": "^1.13.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "zustand": "^5.0.2"
  }
}
